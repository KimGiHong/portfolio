---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import PaperTexture from '@/components/effects/PaperTexture.astro';
import ScrollProgress from '@/components/effects/ScrollProgress.tsx';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import {
  getLocaleFromPath,
  locales,
  ogLocale,
  switchLocalePath,
  type Locale,
  useTranslations,
} from '@/i18n';
import { buildStructuredData, type SchemaInput } from '@/lib/structuredData';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  /** Defaults to the locale implied by the URL (/en/… → 'en'). */
  locale?: Locale;
  /** Page-specific schema.org node; WebSite + Person are always emitted. */
  schema?: SchemaInput;
}

const {
  title,
  description = '',
  ogImage,
  locale = getLocaleFromPath(Astro.url.pathname),
  schema,
} = Astro.props;
const t = useTranslations(locale);

const site = Astro.site ?? Astro.url;
const canonicalURL = new URL(Astro.url.pathname, site);
const alternates = locales.map((l) => ({
  locale: l,
  href: new URL(switchLocalePath(Astro.url.pathname, l), site).toString(),
}));

const structuredData = buildStructuredData(
  new URL(site),
  locale,
  schema && { ...schema, path: Astro.url.pathname, title, description },
);
// Default OG image — 한지 톤 1200×630 PNG (generated from og-image.svg via sharp).
const resolvedOgImage = new URL(ogImage ?? '/og-image.png', Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang={locale} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="theme-color" content="#FAF6EC" />
    <!-- Link-only sharing: kept out of search engines on purpose (2026-10). -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL.toString()} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.locale} href={alt.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />

    <meta property="og:type" content={schema?.kind === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content={t('meta.siteName')} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonicalURL.toString()} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={resolvedOgImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

    <ClientRouter />
  </head>
  <body class="bg-paper-base text-ink-body antialiased min-h-screen flex flex-col overflow-x-hidden">
    <PaperTexture />
    <ScrollProgress client:load />
    <Header />
    <main id="main" class="relative z-[2] flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
